{
  "name": "behavtest",
  "version": "0.7.1",
  "description": "Behavioral regression testing for AI applications: run test cases repeatedly through your LLM app, AI agent or RAG pipeline, score every answer, and use statistics to tell a real regression from noise. Vendor-neutral, local, no infrastructure. Previously named Regrade.",
  "keywords": [
    "behavioral-testing",
    "regression-testing",
    "ai-testing",
    "ai-regression-testing",
    "llm",
    "llm-testing",
    "llm-evaluation",
    "evals",
    "llm-regression-testing",
    "llm-as-a-judge",
    "prompt-testing",
    "rag",
    "rag-evaluation",
    "ai-agents",
    "agent-evaluation",
    "tool-calling",
    "nondeterminism",
    "ci",
    "github-actions",
    "openai",
    "anthropic",
    "cli",
    "typescript"
  ],
  "license": "MIT",
  "author": "Dhrumil Bhut",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhrumilbhut/behavtest.git"
  },
  "homepage": "https://github.com/dhrumilbhut/behavtest#readme",
  "bugs": {
    "url": "https://github.com/dhrumilbhut/behavtest/issues"
  },
  "type": "module",
  "bin": {
    "behavtest": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/suite.schema.json": "./schema/suite.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run clean && tsup && node dist/cli.js schema --out schema/suite.schema.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepublishOnly": "npm run check && npm run build",
    "clean": "node -e \"require(\\\"node:fs\\\").rmSync(\\\"dist\\\",{recursive:true,force:true})\"",
    "sample-report": "npm run build && node scripts/sample-report.mjs",
    "site": "npm run build && node scripts/sample-report.mjs --out site/sample && node scripts/site.mts --out site"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
